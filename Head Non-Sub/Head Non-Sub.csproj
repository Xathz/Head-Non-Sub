<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<Platforms>x64</Platforms>
    <RootNamespace>HeadNonSub</RootNamespace>
    <StartupObject>HeadNonSub.Program</StartupObject>
    <!-- Run with "dotnet HeadNonSub.dll", the apphost would clash with the HeadNonSub working directory on Linux -->
    <UseAppHost>false</UseAppHost>
    <Authors>Xathz</Authors>
    <Description>Non-subs are the worst, they come in here and act like they own the place. At least I am the head of them all.</Description>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0</AssemblyVersion>
    <FileVersion>3.0.0</FileVersion>
    <AssemblyName>HeadNonSub</AssemblyName>
    <PackageProjectUrl>https://github.com/Xathz/Head-Non-Sub</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/Xathz/Head-Non-Sub/master/ProfilePicture128.png</PackageIconUrl>
    <RepositoryUrl>https://github.com/Xathz/Head-Non-Sub</RepositoryUrl>
    <PackageTags>discord, bot, discord-bot, paymoneywubby</PackageTags>
    <RepositoryType>git</RepositoryType>
    <Copyright>Xathz</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Title>Head Non-Sub Discord Bot</Title>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>bin\Debug\</OutputPath>
    <CodeAnalysisRuleSet />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <CodeAnalysisRuleSet />
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Unused\**" />
    <EmbeddedResource Remove="Unused\**" />
    <None Remove="Unused\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Clients\Discord\Commands\Exclamation\Raves.cs" />
    <Compile Remove="Clients\Discord\RaveTracker.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Clients\Discord\Commands\Commands.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Webhook" Version="3.20.2" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Magick.NET-Q16-HDRI-x64" Version="15.0.0" />
    <!-- Latest patch supported by Pomelo, there is no EF Core 10 version of Pomelo yet -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <!-- Overrides the vulnerable version pulled in by B2Net -->
    <PackageReference Include="Microsoft.NETCore.Jit" Version="2.0.8" />
    <PackageReference Include="NLog" Version="6.2.1" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="TwitchLib" Version="3.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
